@startuml
skinparam dpi 150
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName SansSerif
skinparam nodesep 25
skinparam ranksep 45
left to right direction

actor "Étudiant" as E
actor "Secrétariat" as S
actor "Responsable\npédagogique" as R
actor "Encadreur" as N
actor "Administrateur" as A

rectangle "Application de gestion des stages et soutenances" {
  usecase "Soumettre une\ndemande de stage" as UC1
  usecase "Consulter l'état de\nses demandes" as UC2
  usecase "Affecter un\nencadreur" as UC3
  usecase "Rechercher\nun dossier" as UC4
  usecase "Programmer une\nsoutenance" as UC5
  usecase "Valider ou refuser\nune demande" as UC6
  usecase "Consulter ses\nétudiants affectés" as UC7
  usecase "Gérer les comptes\net les rôles" as UC8
}

E --> UC1
E --> UC2
S --> UC3
S --> UC4
S --> UC5
R --> UC6
N --> UC7
A --> UC8
@enduml
